# ============================================================================
# DR-VERGE frontend environment
#
# Copy to `.env` (or `.env.local`) and fill in. Every VITE_* value is INLINED
# INTO THE BROWSER BUNDLE at build time — it is public. Never put an API key,
# token, or any other secret in this file.
# ============================================================================

# Public DR-VERGE inference endpoint. Accepts multipart/form-data with the
# fields `macula` and `optic_disc`. Leave EMPTY while the model is not yet
# deployed — the demo then falls back to clearly-labelled mock mode.
VITE_MODEL_API_URL=

# Force mock inference on ("true") or off ("false").
# When unset, mock mode turns itself on if VITE_MODEL_API_URL is empty, so the
# demo page is never a dead end. Set to "false" once the model is live.
VITE_USE_MOCK_MODEL=false

# Downloadable sample dual-view fundus image pairs (e.g. a Google Drive folder).
# The site links to it; it never redistributes dataset files itself.
VITE_SAMPLE_DATASET_URL=https://drive.google.com/drive/folders/1696R94LIC2lmZ_0-Z6cx2vm_2jRSl3hi?usp=sharing

# Paper PDF.
VITE_PAPER_URL=

# Source repository.
VITE_GITHUB_URL=https://github.com/StyNW7/DR-VERGE

# Shown in the footer and research metadata.
VITE_INSTITUTION=BINUS University

# Inference request timeout in milliseconds.
VITE_REQUEST_TIMEOUT_MS=45000
